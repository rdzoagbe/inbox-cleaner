# Google OAuth — get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Microsoft (Outlook / Hotmail) — Azure portal > App registrations
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_client_secret
# Optional, defaults to GOOGLE_REDIRECT_URI
MICROSOFT_REDIRECT_URI=http://localhost:5173

# Stripe — get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRICE_ID=your_stripe_price_id

# App URL
VITE_APP_URL=http://localhost:5173
